# ─── Agent (Claude) ──────────────────────────────────────────────
# Without a key the app still runs: the deterministic offline agent answers instead.
ANTHROPIC_API_KEY=
# claude | offline | auto (auto = try Claude, fall back to offline on any error)
AGENT_MODE=auto
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (lower = faster replies on stage)
AGENT_EFFORT=low

# ─── Tokenomist (sponsor) ───────────────────────────────────────
# Without a key every call reads data/fixtures (SAMPLE data, labelled in the UI).
# Ask the Tokenomist booth for a hackathon key: the free trial has no forward unlocks.
TOKENOMIST_API_KEY=
TOKENOMIST_BASE_URL=https://api.tokenomist.ai

# ─── Market data (price / 24h volume) ───────────────────────────
# live = CoinGecko public API, fixture = data/fixtures/market.json
MARKET_SOURCE=fixture

# ─── ElevenLabs (sponsor) ───────────────────────────────────────
# Without a key the browser's built-in th-TH voice and speech recognition are used instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 supports Thai; eleven_multilingual_v2 does not
ELEVENLABS_MODEL_ID=eleven_v3
# Speech-to-text (mic button). scribe_v2 also exists; check which your plan has.
ELEVENLABS_STT_MODEL_ID=scribe_v1

# ─── Avalanche (sponsor) ────────────────────────────────────────
# Fuji testnet only. Without a key, "protect" writes a SIMULATED receipt.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Read live AVAX balance for this address into the demo portfolio (optional)
WALLET_ADDRESS=
# Testnet-only demo signer for the on-chain protection receipt. NEVER a mainnet key.
DEMO_PRIVATE_KEY=

# ─── U-Bot (U-topia) ────────────────────────────────────────────
# mock = in-app chat panel. webhook = POST replies to UBOT_WEBHOOK_URL (adjust payload in src/lib/ubot/webhook.ts once U-topia shares the spec)
UBOT_ADAPTER=mock
UBOT_WEBHOOK_URL=
UBOT_API_KEY=
